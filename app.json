{
  "expo": {
    "name": "SGML",
    "slug": "sitaram-dairy-app",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/newapplogo.png",
    "scheme": "sitaramdairyapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/newapplogo.png",
      "bundleIdentifier": "com.sgml.app",
      "buildNumber": "4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 4,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/newapplogo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sgml.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#800000",
          "android": {
            "image": "./assets/images/logo.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ce6ea5f3-f5e7-4ed7-ad3e-ac9255e1ab7f"
      }
    }
  }
}